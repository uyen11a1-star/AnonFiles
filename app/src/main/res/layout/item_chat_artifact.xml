<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    android:padding="12dp"
    android:background="#FFFFFF"
    android:elevation="2dp">

    <TextView
        android:id="@+id/artHead"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FF1493"
        android:textSize="12sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:ellipsize="middle"
        android:maxLines="1" />

    <TextView
        android:id="@+id/artMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#8888A0"
        android:textSize="11sp"
        android:maxLines="1"
        android:ellipsize="middle" />

    <WebView
        android:id="@+id/artWeb"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginTop="8dp"
        android:background="#FAFAFE"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/artImg"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginTop="8dp"
        android:scaleType="centerCrop"
        android:visibility="gone"
        android:contentDescription="artifact" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:gravity="end">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/artOpen"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mở đầy đủ"
            android:textColor="#FF1493" />
    </LinearLayout>
</LinearLayout>
