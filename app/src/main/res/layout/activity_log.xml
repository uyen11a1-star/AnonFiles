<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F0524">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/logToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@drawable/rainbow_bar"
        app:navigationIcon="@android:drawable/ic_menu_revert"
        app:title="Agent Log"
        app:titleTextColor="#1A1A2E" />

    <ScrollView
        android:id="@+id/logScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <HorizontalScrollView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/logBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:textColor="#C4B5FD"
                android:textIsSelectable="true"
                android:lineSpacingMultiplier="1.15" />
        </HorizontalScrollView>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="#1E1035">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/logCopy"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Copy tất cả"
            android:textColor="#6EE7FF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/logSave"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Lưu ra file"
            android:textColor="#6EE7FF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/logClear"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Xóa log"
            android:textColor="#FF6EC7" />
    </LinearLayout>
</LinearLayout>
