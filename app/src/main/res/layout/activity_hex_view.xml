<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F0524">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/hexToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@drawable/rainbow_bar"
        app:navigationIcon="@android:drawable/ic_menu_revert"
        app:title="Hex Viewer"
        app:titleTextColor="#1A1A2E" />

    <TextView android:id="@+id/hexInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:background="#1E1035"
        android:textColor="#FFD1F5"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:maxLines="1"
        android:ellipsize="middle" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="vertical|horizontal">
        <HorizontalScrollView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView android:id="@+id/hexBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:textColor="#C4B5FD"
                android:textIsSelectable="true"/>
        </HorizontalScrollView>
    </ScrollView>
</LinearLayout>
