<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Địa chỉ OmniRoute"
        android:textSize="12sp"
        android:textColor="#3A3A5C" />
    <EditText
        android:id="@+id/cfgUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="http://127.0.0.1:20128"
        android:inputType="textUri"
        android:importantForAutofill="no" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="API Key (để trống nếu không cần)"
        android:textSize="12sp"
        android:textColor="#3A3A5C" />
    <EditText
        android:id="@+id/cfgKey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="sk-..."
        android:inputType="textPassword"
        android:importantForAutofill="no" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Model"
        android:textSize="12sp"
        android:textColor="#3A3A5C" />
    <EditText
        android:id="@+id/cfgModel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="gpt-4o-mini"
        android:inputType="text"
        android:importantForAutofill="no" />

    <TextView
        android:id="@+id/cfgTest"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textSize="12sp"
        android:textColor="#3A3A5C"
        android:fontFamily="monospace" />
</LinearLayout>
