<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FAFAFE">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/aiToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@drawable/rainbow_bar"
        app:navigationIcon="@android:drawable/ic_menu_close_clear_cancel"
        app:title="AI Chat"
        app:titleTextColor="#1A1A2E"
        app:subtitleTextColor="#666680" />

    <TextView
        android:id="@+id/aiContext"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:background="#F0EFF7"
        android:textSize="11sp"
        android:textColor="#3A3A5C"
        android:maxLines="1"
        android:ellipsize="middle" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/aiRecycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingEnd="8dp"
        android:clipToPadding="false"
        android:paddingBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="#FFFFFF"
        android:elevation="4dp">

        <EditText
            android:id="@+id/aiInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="44dp"
            android:maxHeight="120dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:hint="Nhập tin nhắn..."
            android:inputType="textMultiLine|textCapSentences"
            android:background="#F0EFF7"
            android:textColor="#1A1A2E"
            android:textColorHint="#8888A0"
            android:textSize="14sp"
            android:importantForAutofill="no" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/aiSend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Gửi"
            app:backgroundTint="#FF1493"
            android:textColor="#FFFFFF" />
    </LinearLayout>
</LinearLayout>
